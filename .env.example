# Groq API Key (Free tier key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model Settings
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
FAST_LLM_MODEL=openai/gpt-oss-20b

# Vector DB & Embeddings Settings
CHROMA_PERSIST_DIR=./data/chroma
BM25_PERSIST_PATH=./data/bm25.pkl
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid Search Settings
RETRIEVAL_TOP_K=10
RERANK_TOP_K=4
RRF_K=60
CROSS_ENCODER_THRESHOLD=-5.0

# API & UI Configuration
API_HOST=0.0.0.0
API_PORT=8000
